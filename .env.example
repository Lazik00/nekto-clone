# Environment
ENVIRONMENT=development
DEBUG=True

# Database
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=nekto
POSTGRES_PASSWORD=nekto_secure_password_123
POSTGRES_DB=nekto

# Local quick test only
USE_SQLITE=False
SQLITE_DB_PATH=nekto.db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Security / JWT
JWT_SECRET=change-this-jwt-secret-to-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
JWT_REFRESH_EXPIRE_DAYS=30

# TURN/STUN
TURN_SERVER=turn:localhost:3478
TURN_USERNAME=nekto
TURN_PASSWORD=super_secret_password_123
STUN_SERVER=stun:stun.l.google.com:19302

# API
CORS_ORIGINS=["http://localhost:5173", "http://localhost:8080", "http://127.0.0.1:8080"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "backend", "frontend"]
WORKERS=4

# Matchmaking
MATCH_TIMEOUT_SECONDS=120
MAX_MATCHES_PER_HOUR=10
MESSAGE_RETENTION_DAYS=30

# Project
PROJECT_NAME=Nekto Clone
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=admin@nekto.local
